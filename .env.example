# KnowledgeAI environment (blueprint §5.2). Copy to `.env` for local development: `cp .env.example .env`
# `.env` is git-ignored. Never commit real values, and never paste a real .env into chats or bug reports.
# The backend refuses to start if a required value is missing, too short, or still a placeholder (backend/app/config.py).

# development | test | staging | production. Each environment uses its own credentials.
APP_ENV=development
LOG_LEVEL=INFO
# IANA zone used when showing times; the backend stores UTC only.
TENANT_TIMEZONE=America/Chicago

# Local Postgres from compose.yaml (host port 55432). "dev-only" credentials are rejected in staging/production.
# The API connects as the non-superuser app role so row-level security applies (ADR-011).
DATABASE_URL=postgresql+psycopg://knowledgeai_app:knowledgeai-app-dev-only@127.0.0.1:55432/knowledgeai
# Schema owner, used only by Alembic migrations.
MIGRATION_DATABASE_URL=postgresql+psycopg://knowledgeai:knowledgeai-dev-only@127.0.0.1:55432/knowledgeai

# Local Chroma from compose.yaml (host port 8001 → container 8000). Never exposed publicly.
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001
# CHROMA_SSL=false                         # must be true in staging/production (ADR-020)
# Database timeouts (§11.3). Staging/production also need ?sslmode=require (or verify-full) on DATABASE_URL.
# DB_CONNECT_TIMEOUT_SECONDS=5
# DB_STATEMENT_TIMEOUT_MS=15000
# DB_APPLICATION_NAME=knowledgeai            # per service when deployed: knowledgeai-api, knowledgeai-worker

# local = files under data/uploads (git-ignored); staging/production require s3 + bucket.
STORAGE_BACKEND=local
# S3_BUCKET=knowledgeai-staging
# S3_ENDPOINT_URL=https://s3.example.com   # only for S3-compatible stores; unset for AWS
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=                      # leave unset on a cloud host: the instance/task role is used
# S3_SECRET_ACCESS_KEY=
# S3_CONNECT_TIMEOUT_SECONDS=5
# S3_READ_TIMEOUT_SECONDS=30
# S3_MAX_ATTEMPTS=3                        # including the first try

# Model providers: local | fake | openai.
# - fake: deterministic offline substitute; the test suite and CI use it, so keep it here for `pytest`.
# - local (the decision, ADR-026): our own models from LLM/, served by `docker compose --profile llm up -d`
#   (add -f compose.gpu.yaml on an NVIDIA GPU). No key, no cost. The `app` compose profile already uses them.
#   To run `fastapi dev` and the worker on them, replace the six fake lines below with the block after them,
#   then rebuild the index into the new collection: cd backend; .venv/Scripts/python -m app.ingestion.rebuild
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=fake-embedding
EMBEDDING_DIMENSION=384
LLM_PROVIDER=fake
LLM_MODEL=fake-llm
LLM_API_KEY=replace-locally
# --- Local models (ADR-026) ---
# LLM_PROVIDER=local
# LLM_MODEL=qwen3-4b-instruct-2507-q4_k_m
# LLM_BASE_URL=http://127.0.0.1:8080/v1
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=nomic-embed-text-v1.5-q8_0
# EMBEDDING_DIMENSION=768
# EMBEDDING_BASE_URL=http://127.0.0.1:8081/v1
# EMBEDDING_QUERY_PREFIX="search_query: "
# EMBEDDING_DOCUMENT_PREFIX="search_document: "
# CHROMA_COLLECTION=knowledge_chunks_local_v1
# Optional reranker (ADR-028; the compose service `reranker`) and the evidence rule it relaxes:
# RERANKER_PROVIDER=local
# RERANKER_BASE_URL=http://127.0.0.1:8082/v1
# RERANK_RELAXED_SCORE=1.5
# RERANK_RELAXED_COVERAGE=0.4
# On a CPU-only machine answers are slower: raise LLM_TIMEOUT_SECONDS and REQUEST_DEADLINE_SECONDS (deployment.md §1).
# Embedding spend logging (USD per 1k tokens; 0 for the fake provider).
# EMBEDDING_PRICE_PER_1K_TOKENS=0.00002
# Estimated cost per question on the Operations page (§13.1): list prices in USD per 1k tokens, 0 for fake providers.
# LLM_PRICE_PER_1K_INPUT_TOKENS=0
# LLM_PRICE_PER_1K_OUTPUT_TOKENS=0
# LLM_DAILY_BUDGET_USD=                    # alert (model_budget) when 24 h of estimated spend reaches it

# Hybrid retrieval (§8.5, ADR-028): keyword search for questions naming a code, fused by reciprocal rank.
# KEYWORD_SEARCH=true
# RRF_K=60
# RERANKER_PROVIDER=none                  # none | local (see the local models block above)

# Order status checks (US-05, ADR-029): mismatches allowed per caller and per order number in the window.
# ORDER_LOOKUP_MAX_FAILURES=5
# ORDER_LOOKUP_WINDOW_SECONDS=900

# Upload and ingestion limits (§7.1). Defaults shown.
# MAX_UPLOAD_BYTES=20971520
# MAX_PDF_PAGES=300
# MAX_ACTIVE_INGESTIONS_PER_ORG=5
# CHUNK_TARGET_TOKENS=500
# CHUNK_MAX_TOKENS=700
# CHUNK_OVERLAP_TOKENS=75
# builtin (dev/test: executable signatures + EICAR) | clamd (required in staging/production)
# MALWARE_SCANNER=builtin
# CLAMD_HOST=127.0.0.1
# CLAMD_PORT=3310

# Question answering (§8; budgets in docs/architecture.md §3). Defaults shown.
# PUBLIC_ORGANIZATION=techcare            # organization behind the anonymous public chat
# INTERNAL_SERVICE_ORGANIZATION=techcare  # organization the voice service token answers for
# RETRIEVAL_CANDIDATES=10
# CONTEXT_CHUNKS=5
# CONTEXT_TOKEN_BUDGET=6000
# MIN_EVIDENCE_SIMILARITY=0.05
# MIN_TERM_COVERAGE=0.6
# LLM_TIMEOUT_SECONDS=20
# REQUEST_DEADLINE_SECONDS=30
# RATE_LIMIT_ANONYMOUS_PER_MINUTE=10
# RATE_LIMIT_USER_PER_MINUTE=30
# CHROMA_COLLECTION=knowledge_chunks       # change only together with a rebuild (ADR-013)
# PREVIEW_LINK_SECONDS=300                 # lifetime of signed file links (ADR-018)
# RATE_LIMIT_PUBLIC_PER_MINUTE=300         # all guests together (ADR-020)
# LOGIN_MAX_FAILURES=5                     # per account, then locked for LOGIN_LOCKOUT_SECONDS
# LOGIN_LOCKOUT_SECONDS=900
# INTERNAL_API_ALLOWED_NETWORKS=127.0.0.0/8,::1/128   # where the voice service may call from (CIDRs)

# Worker health and retention (§11.2, §11.3; ADR-019, ADR-020). Defaults shown.
# WORKER_HEARTBEAT_SECONDS=10
# WORKER_STALE_SECONDS=60
# QUEUE_MAX_WAIT_SECONDS=900
# CONVERSATION_RETENTION_DAYS=180          # by last activity
# DELETED_DOCUMENT_PURGE_DAYS=30           # then vectors, files and rows are purged

# Metrics and alerts (§13; ADR-021). Defaults shown. The worker evaluates the alert rules.
# METRICS_RETENTION_DAYS=90                # request metrics and resolved alerts
# METRICS_FLUSH_SECONDS=15                 # how often each API process writes its request counters
# ALERT_INGESTION_FAILURES=5               # failed ingestion jobs within the window
# ALERT_ERROR_RATE=0.05                    # share of 5xx responses within the window …
# ALERT_MIN_REQUESTS=20                    # … once at least this many requests were seen
# ALERT_WINDOW_MINUTES=15
# ALERT_CHECK_SECONDS=60
# ALERT_WEBHOOK_URL=                       # optional Slack-compatible incoming webhook; it is a secret

# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"  (two different values)
AUTH_JWT_SECRET=replace-locally
INTERNAL_SERVICE_TOKEN=replace-locally
# Keys the customer email/phone hashes (ADR-029). Optional in development (derived from AUTH_JWT_SECRET),
# required (32+ characters) in staging and production. Changing it orphans every stored hash.
# CUSTOMER_LOOKUP_SECRET=

# Optional, only if Celery is adopted later (ADR-008).
# REDIS_URL=redis://localhost:6379/0
