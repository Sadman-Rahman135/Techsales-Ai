{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyPlainHttp",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": ["arn:aws:s3:::BUCKET", "arn:aws:s3:::BUCKET/*"],
      "Condition": { "Bool": { "aws:SecureTransport": "false" } }
    },
    {
      "Sid": "AppObjectsOnly",
      "Effect": "Allow",
      "Principal": { "AWS": ["arn:aws:iam::ACCOUNT:role/knowledgeai-api", "arn:aws:iam::ACCOUNT:role/knowledgeai-worker"] },
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::BUCKET/*"
    },
    {
      "Sid": "AppListing",
      "Effect": "Allow",
      "Principal": { "AWS": ["arn:aws:iam::ACCOUNT:role/knowledgeai-api", "arn:aws:iam::ACCOUNT:role/knowledgeai-worker"] },
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::BUCKET"
    }
  ]
}
